LLM_API_KEY=your-universal-api-key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-plus
LLM_ENABLE_THINKING=false
LLM_TIMEOUT=180
LLM_TEMPERATURE=0
LLM_MAX_RETRIES=3
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
RERANK_MODEL=qwen3-rerank
RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1
SCHEMA_RECALL_THRESHOLD=0.55
BM25_TOP_K=30
DENSE_TOP_K=30
RRF_TOP_K=40
MAX_SCHEMA_FIELDS=20
MAX_SAVED_MEMORIES=20
MCP_MAX_TOOL_CALLS=3
SHORT_TERM_SUMMARY_ENABLED=true
SHORT_TERM_SUMMARY_TRIGGER_TOKENS=12000
SHORT_TERM_SUMMARY_BATCH_TOKENS=6000
SHORT_TERM_MIN_RECENT_TURNS=5
SESSION_ARCHIVE_ENABLED=false
SESSION_ARCHIVE_PATH=data/session_archive.db
CONTEXT_TABLE_ROW_LIMIT=50
ROUTE_CONTEXT_TURNS=6

# Application backend remains DuckDB while M1 C PostgreSQL adapters are built.
DATA_BACKEND=duckdb
DATA_SOURCE_ID=short_video_ops_duckdb

# M1 C1: PostgreSQL configuration and recorded source evidence (no pool yet).
# Copy these lines into the SERVER .env; preserve existing model settings.
PG_HOST=127.0.0.1
PG_PORT=55432
PG_DATABASE=askdata_m1_test
PG_SCHEMA=askdata_ops
PG_USER=askdata_readonly
PG_PASSWORD=
PG_SOURCE_ID=short_video_ops_postgres
PG_CONNECT_TIMEOUT_SECONDS=10
PG_STATEMENT_TIMEOUT_MS=120000
PG_LOCK_TIMEOUT_MS=5000
PG_POOL_MIN_SIZE=1
PG_POOL_MAX_SIZE=4
PG_POOL_WAIT_TIMEOUT_SECONDS=10
PG_POOL_MAX_WAITING=16
PG_VERIFIED_DATA_VERSION=882ba07c90b4db91328344b37974f362edf737b1f4f82379c8658fe514c10fa1
# Relative paths always resolve from backend, independent of command cwd.
PG_IMPORT_REPORT_PATH=evaluation/results/m1_b_postgres_import_server.json
PG_VALIDATION_REPORT_PATH=evaluation/results/m1_b_postgres_validation_server.json
