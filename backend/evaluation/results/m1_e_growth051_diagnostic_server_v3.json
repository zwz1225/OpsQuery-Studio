      "sql_metrics": {
        "generated_sql": "SELECT\n  ac.channel_name,\n  COUNT(DISTINCT ur.registration_id) AS registered_users,\n  COUNT(DISTINCT CASE WHEN ua.is_activated <> 0 THEN ur.registration_id END) AS activated_users,\n  ROUND(\n    (COUNT(DISTINCT CASE WHEN ua.is_activated <> 0 THEN ur.registration_id END)::numeric / NULLIF(COUNT(DISTINCT ur.registration_id), 0)),\n    4\n  ) AS activation_rate\nFROM askdata_ops.user_registrations ur\nJOIN askdata_ops.acquisition_channels ac ON ur.channel_id = ac.channel_id\nLEFT JOIN askdata_ops.user_activations ua ON ur.registration_id = ua.registration_id\nWHERE ur.registered_at >= '2026-01-01'::timestamp\n  AND ur.registered_at < '2026-02-01'::timestamp\nGROUP BY ac.channel_name\nORDER BY activation_rate DESC, ac.channel_name ASC",
        "execution_success": true,
        "execution_ms": 2673.801
      },
