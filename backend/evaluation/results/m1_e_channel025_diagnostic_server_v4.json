      "sql_metrics": {
        "generated_sql": "WITH monthly_spend AS (\n  SELECT\n    DATE_TRUNC('month', s.stat_date) AS month_start,\n    SUM(s.spend) AS total_spend\n  FROM askdata_ops.ad_daily_stats s\n  WHERE s.stat_date < '2026-06-01'\n  GROUP BY DATE_TRUNC('month', s.stat_date)\n),\nspend_with_lag AS (\n  SELECT\n    month_start,\n    total_spend,\n    LAG(total_spend) OVER (ORDER BY month_start) AS prev_month_spend\n  FROM monthly_spend\n)\nSELECT\n  TO_CHAR(month_start, 'YYYY-MM') AS \"月份\",\n  ROUND(CAST(total_spend AS numeric), 2) AS \"广告消耗\",\n  ROUND(CAST(\n    CASE \n      WHEN prev_month_spend IS NULL OR prev_month_spend = 0 THEN NULL\n      ELSE (total_spend - prev_month_spend) / prev_month_spend\n    END AS numeric\n  ), 4) AS \"环比变化率\"\nFROM spend_with_lag\nORDER BY month_start ASC",
        "execution_success": true,
        "execution_ms": 2664.831
      },
