      "generated_sql": "SELECT ac.channel_name, ROUND(CAST(CAST((SUM(ads.spend) / NULLIF(SUM(ads.conversions), 0)) AS DECIMAL) - CAST(ct.target_cpa AS DECIMAL) AS DECIMAL), 2) AS target_gap, ROUND(CAST(SUM(ads.spend) / CAST(NULLIF(SUM(ads.conversions), 0) AS DECIMAL) AS DECIMAL), 2) AS actual_cpa, ct.target_cpa FROM askdata_ops.ad_daily_stats AS ads JOIN askdata_ops.ad_campaigns AS camp ON ads.ad_campaign_id = camp.ad_campaign_id JOIN askdata_ops.acquisition_channels AS ac ON camp.channel_id = ac.channel_id JOIN askdata_ops.channel_targets AS ct ON ac.channel_id = ct.channel_id WHERE ads.stat_date >= '2026-01-01' AND ads.stat_date < '2026-02-01' AND ct.target_month = '2026-01' GROUP BY ac.channel_name, ct.target_cpa ORDER BY ac.channel_name ASC",
      "postgres_gold_sql": "WITH actual AS (\n  SELECT\n    p.channel_id,\n    CAST(SUM(s.spend) AS DOUBLE PRECISION) / NULLIF(SUM(s.conversions), 0) AS cpa\n  FROM ad_daily_stats AS s\n  JOIN ad_campaigns AS p\n    ON s.ad_campaign_id = p.ad_campaign_id\n  WHERE\n    TO_CHAR(s.stat_date, 'YYYY-MM') = '2026-01'\n  GROUP BY\n    1\n)\nSELECT\n  c.channel_name,\n  ROUND(CAST(a.cpa AS DECIMAL), 2) AS actual_cpa,\n  t.target_cpa,\n  ROUND(CAST(a.cpa - t.target_cpa AS DECIMAL), 2) AS gap\nFROM channel_targets AS t\nJOIN acquisition_channels AS c\n  ON t.channel_id = c.channel_id\nJOIN actual AS a\n  ON t.channel_id = a.channel_id\nWHERE\n  SUBSTRING(t.target_month FROM 1 FOR 7) = '2026-01'\nORDER BY\n  gap,\n  1",
